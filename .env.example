NODE_ENV=development
PORT=4000
# Local Docker Postgres (docker compose up -d db). For Neon use the pooled connection string,
# e.g. postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://poshak:poshak@localhost:5433/poshak
# Integration tests (wiped on every run)
TEST_DATABASE_URL=postgresql://poshak:poshak@localhost:5433/poshak_test
# Exact origin of poshak-store-app (CORS, credentials). No wildcards.
WEB_ORIGIN=http://localhost:3000
# Used in email links
SITE_URL=http://localhost:3000
# 256-bit secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
GUEST_TOKEN_SECRET=dev-only-guest-secret-change-me-0123456789abcdef
# .poshak.pk in production; leave empty locally
COOKIE_DOMAIN=
# false only for plain-http local development
COOKIE_SECURE=false
LOG_LEVEL=info
# Email: leave RESEND_API_KEY empty to print emails to the log instead of sending
RESEND_API_KEY=
EMAIL_FROM=Poshak <orders@poshak.pk>
# Cloudinary (admin image upload signing) — optional until images are uploaded
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Seed only
SEED_ADMIN_EMAIL=admin@poshak.pk
SEED_ADMIN_PASSWORD=change-me-on-first-login
# Shared with poshak-store-app (same value there). Lets the API rate-limit by the shopper's real IP.
INTERNAL_PROXY_SECRET=dev-only-proxy-secret-change-me-0123456789abcdef
