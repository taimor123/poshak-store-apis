generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// === Identity ===
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?
  passwordHash    String?
  name            String
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  googleId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  cart          Cart?
  orders        Order[]
  wishlistItems WishlistItem[]
}

enum Role {
  CUSTOMER
  ADMIN
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  name       String
  phone      String
  line1      String
  city       String
  province   String?
  postalCode String?
  notes      String?
  isDefault  Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// === Taxonomy & sizing ===
model Category {
  id             String   @id @default(cuid())
  parentId       String?
  name           String
  slug           String   @unique
  sortOrder      Int
  sizeMode       SizeMode
  sizeChartId    String?
  attributeSetId String?
  isActive       Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent       Category?     @relation("CategoryToCategory", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryToCategory")
  products     Product[]
  sizeChart    SizeChart?    @relation(fields: [sizeChartId], references: [id])
  attributeSet AttributeSet? @relation(fields: [attributeSetId], references: [id])
}

enum SizeMode {
  STITCHED
  UNSTITCHED
  NONE
}

model SizeDefinition {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cells     SizeChartCell[]
  overrides ProductSizeOverride[]
  variants  ProductVariant[]
}

model SizeChart {
  id         String   @id @default(cuid())
  name       String
  dimensions String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cells      SizeChartCell[]
  categories Category[]
}

model SizeChartCell {
  chartId     String
  sizeId      String
  dimension   String
  valueInches Decimal @db.Decimal(4, 1)

  chart SizeChart      @relation(fields: [chartId], references: [id])
  size  SizeDefinition @relation(fields: [sizeId], references: [id])

  @@unique([chartId, sizeId, dimension])
}

model AttributeSet {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definitions AttributeDefinition[]
  categories  Category[]
}

model AttributeDefinition {
  id         String   @id @default(cuid())
  setId      String
  key        String
  label      String
  type       AttrType
  filterable Boolean
  required   Boolean
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  set           AttributeSet            @relation(fields: [setId], references: [id])
  options       AttributeValueOption[]
  productValues ProductAttributeValue[]
}

model AttributeValueOption {
  id           String   @id @default(cuid())
  definitionId String
  value        String
  label        String
  sortOrder    Int
  active       Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition AttributeDefinition @relation(fields: [definitionId], references: [id])
}

enum AttrType {
  SELECT
  MULTI_SELECT
  TEXT
  BOOLEAN
  NUMBER
}

// === Catalog ===
model Product {
  id             String        @id @default(cuid())
  categoryId     String
  name           String
  slug           String        @unique
  code           String
  description    String
  pricePaisa     Int
  compareAtPaisa Int?
  status         ProductStatus @default(DRAFT)
  fitNote        String?
  isFinalSale    Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category        Category                @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  attributeValues ProductAttributeValue[]
  fabricContents  FabricContent[]
  sizeOverrides   ProductSizeOverride[]

  @@index([categoryId, status])
  @@index([publishedAt])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sizeId     String?
  color      String?
  sku        String   @unique
  stock      Int      @default(0)
  pricePaisa Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product         Product           @relation(fields: [productId], references: [id])
  size            SizeDefinition?   @relation(fields: [sizeId], references: [id])
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reservations    Reservation[]
  ledgers         InventoryLedger[]
  backInStockSubs BackInStockSub[]

  // In PG, unique over nullable fields means multiple (1, null, null) can exist, but it helps indexing
  // @@unique([productId, sizeId, color]) - leaving this commented if it causes Prisma issues, 
  // but let's try with it uncommented.
  @@unique([productId, sizeId, color])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String
  sortOrder Int
  isCover   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model ProductAttributeValue {
  productId    String
  definitionId String
  value        Json

  product    Product             @relation(fields: [productId], references: [id])
  definition AttributeDefinition @relation(fields: [definitionId], references: [id])

  @@id([productId, definitionId])
}

model FabricContent {
  id           String   @id @default(cuid())
  productId    String
  piece        Piece
  fabric       String
  lengthMeters Decimal  @db.Decimal(3, 1)
  detail       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

enum Piece {
  SHIRT
  DUPATTA
  TROUSER
}

model ProductSizeOverride {
  productId   String
  sizeId      String
  dimension   String
  valueInches Decimal @db.Decimal(4, 1)

  product Product        @relation(fields: [productId], references: [id])
  size    SizeDefinition @relation(fields: [sizeId], references: [id])

  @@id([productId, sizeId, dimension])
}

// === Cart ===
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  anonId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  qty       Int
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// === Orders ===
model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  userId        String?
  guestEmail    String?
  guestPhone    String?
  guestToken    String?
  status        OrderStatus
  subtotalPaisa Int
  shippingPaisa Int
  discountPaisa Int
  totalPaisa    Int
  shipName      String
  shipPhone     String
  shipLine1     String
  shipCity      String
  shipProvince  String?
  shipNotes     String?
  courier       String?
  trackingNo    String?
  cancelReason  String?
  placedAt      DateTime
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  items          OrderItem[]
  events         OrderEvent[]
  payments       Payment[]
  returnRequests ReturnRequest[]
  reservations   Reservation[]

  @@index([status, placedAt])
  @@index([userId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  variantId      String?
  productName    String
  sizeLabel      String?
  color          String?
  sku            String
  unitPricePaisa Int
  qty            Int
  imageUrl       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order       Order           @relation(fields: [orderId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  ActorType
  actorId    String?
  note       String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

enum ActorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

// === Payments ===
model Payment {
  id          String    @id @default(cuid())
  orderId     String
  method      PayMethod
  status      PayStatus
  amountPaisa Int
  provider    String?
  providerRef String?   @unique
  proofUrl    String?
  collectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]
}

enum PayMethod {
  COD
  CARD
  BANK_TRANSFER
}

enum PayStatus {
  PENDING
  PAID
  COLLECTED
  FAILED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  amountPaisa Int
  method      String
  reference   String?
  reason      String
  actorId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
}

// === Returns ===
model ReturnRequest {
  id                String       @id @default(cuid())
  orderId           String
  status            ReturnStatus
  reason            String
  customerNote      String?
  adminNote         String?
  photoUrls         String[]
  refundBankDetails Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id])
  items ReturnItem[]
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnItem {
  id              String     @id @default(cuid())
  returnRequestId String
  orderItemId     String
  qty             Int
  qcOutcome       QcOutcome?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  request   ReturnRequest @relation(fields: [returnRequestId], references: [id])
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])
}

enum QcOutcome {
  SELLABLE
  DAMAGED
}

// === Inventory & ops ===
model Reservation {
  id        String    @id @default(cuid())
  variantId String
  orderId   String
  qty       Int
  status    ResStatus
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
}

enum ResStatus {
  ACTIVE
  CONVERTED
  RELEASED
}

model InventoryLedger {
  id           String       @id @default(cuid())
  variantId    String
  delta        Int
  reason       String
  source       LedgerSource
  refId        String?
  actorId      String?
  balanceAfter Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
}

enum LedgerSource {
  ORDER
  CANCEL
  RETURN
  ADMIN
  SYSTEM
}

model ShippingZone {
  id           String   @id @default(cuid())
  city         String   @unique
  zone         String
  feePaisa     Int
  estimateText String
  active       Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StoreConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  type       ColType
  bannerUrls Json?
  productIds String[]
  active     Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ColType {
  MANUAL
  AUTO_NEW
  AUTO_SALE
  AUTO_BESTSELLER
}

model BackInStockSub {
  id         String    @id @default(cuid())
  variantId  String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, email])
}
